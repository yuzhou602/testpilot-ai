# TestPilot AI Environment Variables

# Database
DB_URL=jdbc:mysql://localhost:3306/testpilot?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=TestPilotAI2024SecretKeyForJwtTokenGenerationMustBe32Bytes!!
JWT_EXPIRATION=86400000

# OpenAI / LLM
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o

# Server
SERVER_PORT=8080

# Features
API_DOCS_ENABLED=false
SWAGGER_ENABLED=false
