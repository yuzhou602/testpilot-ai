# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_size = 4

[*.{xml,yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.vue]
indent_size = 2

[*.{ts,tsx,js,jsx}]
indent_size = 2

[*.{css,scss,less}]
indent_size = 2

[Dockerfile]
indent_size = 4

[*.sql]
indent_size = 4
